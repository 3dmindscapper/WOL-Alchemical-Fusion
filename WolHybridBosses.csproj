<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net35 plugins load fine on old and new Unity Mono runtimes -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>WolHybridBosses</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- r2modman profile for Wizard of Legend: holds BepInEx and the plugins folder -->
    <BepInDir>C:\Users\migne\AppData\Roaming\r2modmanPlus-local\WizardOfLegend\profiles\Default</BepInDir>

    <!-- CHECK THIS: the Steam folder that contains the game exe and the *_Data folder -->
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Wizard of Legend</GameDir>

    <!-- CHECK THIS if needed: the *_Data\Managed folder inside GameDir -->
    <ManagedDir>$(GameDir)\WizardOfLegend_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ManagedDir)\UnityEngine*.dll">
      <Private>false</Private>
    </Reference>
    <!-- Optional (soft dependency): LegendAPI registers the White Mantle as a wardrobe robe when it's installed -->
    <Reference Include="LegendApi">
      <HintPath>$(BepInDir)\BepInEx\plugins\RandomlyAwesome-LegendAPI\LegendApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copies the built plugin into the r2modman profile's plugins folder after each build -->
  <Target Name="CopyToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInDir)\BepInEx\plugins" />
  </Target>

</Project>
